rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify user owns the document or UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile settings
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Master schedule tasks (definitions, repeat settings)
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Daily completion records for tasks (keyed by date and taskId or doc id)
    match /dailyCompletions/{completionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Daily progress summaries & streaks
    match /dailyProgress/{progressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Water logs per day
    match /waterLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Meal tracking logs
    match /meals/{mealId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
